{
  "name": "@mattrax/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run dev",
    "dev:cert": "node scripts/dev-cert.mjs",
    "db:up": "docker compose up -d mysql",
    "db:migrate": "pnpm api db:migrate",
    "catalog:sync": "node scripts/catalog-sync/sync.mjs",
    "catalog:split": "node scripts/split-policy-catalog.mjs",
    "catalog:check": "node scripts/split-policy-catalog.mjs --check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bench:fleet": "node apps/api/scripts/fleet-bench.mjs",
    "mdm:compliance": "pnpm --filter @mattrax/mdm-compliance start",
    "format": "vp fmt && vp lint",
    "typecheck": "pnpm -r --if-present run cf:types && tsc -b",
    "api": "pnpm --filter @mattrax/api --",
    "web": "pnpm --filter @mattrax/web --",
    "doc": "rspress dev docs --port 9060",
    "doc:build": "rspress build docs",
    "deploy:prod:all": "pnpm api deploy:prod && pnpm web deploy:prod",
    "doc:preview": "rspress preview docs --port 9060",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "bundle:check": "node scripts/bundle-budget.mjs",
    "lighthouse": "lhci autorun"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@fontsource-variable/geist": "^5.3.0",
    "@lhci/cli": "catalog:",
    "@oxlint/plugins": "1.91.0",
    "@playwright/test": "catalog:",
    "@rspress/core": "catalog:",
    "@rspress/plugin-llms": "catalog:",
    "@types/react": "catalog:",
    "oxlint": "1.91.0",
    "react": "catalog:",
    "tar": "^7.5.22",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "^5.1.0",
    "yaml": "^2.8.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.2"
}
