{
  "name": "@mattrax/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run dev",
    "dev:cert": "tsx scripts/dev-cert.ts",
    "db:up": "docker compose up -d mysql",
    "db:migrate": "pnpm cloud db:migrate",
    "catalog:sync": "tsx scripts/catalog-sync/sync.ts",
    "catalog:split": "tsx scripts/split-policy-catalog.ts",
    "catalog:check": "tsx scripts/split-policy-catalog.ts --check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bench:fleet": "tsx apps/cloud/scripts/fleet-bench.ts",
    "mdm:compliance": "pnpm --filter @mattrax/mdm-compliance start",
    "format": "vp fmt && vp lint",
    "typecheck": "pnpm -r --if-present run cf:types && tsc -b",
    "web": "pnpm --filter @mattrax/web --",
    "doc": "pnpm docs:api && rspress dev -c docs/.config/rspress.config.ts --port 9060",
    "doc:build": "pnpm docs:api && rspress build -c docs/.config/rspress.config.ts",
    "licenses": "tsx scripts/generate-licences.ts",
    "docs:api": "tsx scripts/generate-api-reference.ts",
    "deploy:prod:all": "pnpm cloud deploy:prod && pnpm web deploy:prod",
    "doc:preview": "rspress preview -c docs/.config/rspress.config.ts --port 9060",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "bundle:check": "tsx scripts/bundle-budget.ts",
    "lighthouse": "lhci autorun --config=packages/config/lighthouserc.cjs",
    "build:selfhost": "pnpm doc:build && pnpm docker build:api && pnpm --filter @mattrax/web build:selfhost && node apps/docker/scripts/stage.ts . dist-selfhost",
    "license:issue": "pnpm cloud license:issue",
    "cloud": "pnpm --filter @mattrax/cloud --",
    "docker": "pnpm --filter @mattrax/docker --"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@fontsource-variable/geist": "catalog:",
    "@lhci/cli": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@playwright/test": "catalog:",
    "@rspress/core": "catalog:",
    "@rspress/plugin-llms": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "tar": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.2"
}
