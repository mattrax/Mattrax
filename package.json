{
  "name": "@mattrax/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run dev",
    "test": "vitest run",
    "format": "vp fmt && vp lint",
    "typecheck": "pnpm -r --if-present run cf:types && tsc -b",
    "api": "pnpm --filter @mattrax/api --",
    "mserver": "pnpm --filter @mattrax/server --",
    "web": "pnpm --filter @mattrax/web --",
    "doc": "vitepress dev docs",
    "doc:build": "vitepress build docs",
    "deploy:prod:all": "pnpm api deploy:prod && pnpm web deploy:prod"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitepress": "catalog:",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.2"
}
