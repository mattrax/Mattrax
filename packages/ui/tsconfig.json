{
  "extends": "../config/tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "declaration": false,
    "emitDeclarationOnly": false,
    "composite": false
  },
  "include": ["src"]
}
