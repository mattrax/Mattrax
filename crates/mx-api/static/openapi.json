{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "paths": {
    "/health": {
      "description": "Check the health of the API",
      "get": {
        "summary": "Health",
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "The system is unhealthy"
          }
        }
      }
    },
    "/api/v1/register": {
      "post": {
        "summary": "Register account",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "john@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "password"
                  },
                  "name": {
                    "type": "string",
                    "optional": true,
                    "example": "John Doe"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Authenticated"
          },
          "409": {
            "description": "User already exists with the provided email"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/v1/login": {
      "post": {
        "summary": "Login to account",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "john@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "password"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Authenticated"
          },
          "409": {
            "description": "User already exists with the provided email"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "summary": "Get account",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "User",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "User identifier"
                    },
                    "email": {
                      "type": "string",
                      "description": "User email"
                    },
                    "name": {
                      "type": "string",
                      "description": "User name"
                    },
                    "created": {
                      "type": "string",
                      "description": "User creation date"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "patch": {
        "summary": "Update account",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "optional": true,
                    "example": "John Doe"
                  },
                  "email": {
                    "type": "string",
                    "optional": true,
                    "example": "john@example.com"
                  },
                  "password": {
                    "type": "string",
                    "optional": true,
                    "example": "password"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "User",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "User identifier"
                    },
                    "email": {
                      "type": "string",
                      "description": "User email"
                    },
                    "name": {
                      "type": "string",
                      "description": "User name"
                    },
                    "created": {
                      "type": "string",
                      "description": "User creation date"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "409": {
            "description": "User already exists with the provided email"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "delete": {
        "summary": "Delete account",
        "responses": {
          "501": {
            "description": "Service is not yet implemented"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/v1/tenant": {
      "post": {
        "summary": "Create tenant",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Tenant name",
                    "example": "Acme School Inc"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "description": "Created tenant identifier"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "get": {
        "summary": "Get all tenants",
        "description": "Get all tenants for the authenticated user",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Tenant identifier"
                      },
                      "name": {
                        "type": "string",
                        "description": "Tenant name"
                      },
                      "created": {
                        "type": "string",
                        "description": "Tenant creation date"
                      },
                      "apns": {
                        "type": "object",
                        "description": "APNS certificate",
                        "properties": {
                          "email": {
                            "type": "string",
                            "description": "Apple ID email used for APNS certificate"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/v1/tenant/{tenantId}": {
      "get": {
        "summary": "Get tenant",
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "g0kLTz0--BP6"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Tenant identifier"
                  },
                  "name": {
                    "type": "string",
                    "description": "Tenant name"
                  },
                  "created": {
                    "type": "string",
                    "description": "Tenant creation date"
                  },
                  "apns": {
                    "type": "object",
                    "description": "APNS certificate",
                    "properties": {
                      "email": {
                        "type": "string",
                        "description": "Apple ID email used for APNS certificate"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Tenant not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "patch": {
        "summary": "Update tenant",
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "g0kLTz0--BP6"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "optional": true,
                    "example": "Acme School Inc"
                  },
                  "email": {
                    "type": "string",
                    "optional": true,
                    "example": "acme@example.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully updated tenant"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Tenant not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "delete": {
        "summary": "Delete tenant",
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "g0kLTz0--BP6"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successfully deleted tenant"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Tenant not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/v1/tenant/{tenantId}/apns": {
      "get": {
        "summary": "Get APNS CSR",
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "g0kLTz0--BP6"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/x-plist": {
                "schema": {
                  "description": "The `Certificate Signing Request.plist` file. You should upload this file to the [Apple Push Cert Portal](https://identity.apple.com/pushcert) to create an APNS certificate and upload the PEM returned by Apple to Mattrax using `POST /api/v1/tenant/{tenantId}/apns`."
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Tenant not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "summary": "Update APNS certificate",
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "g0kLTz0--BP6"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "description": "Apple ID email used for APNS certificate"
                  },
                  "cert": {
                    "type": "string",
                    "description": "APNS certificate downloaded from Apple Push Cert Portal"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successfully updated the APNS certificate"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Tenant not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
