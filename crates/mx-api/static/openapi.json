{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "paths": {
    "/health": {
      "description": "Check the health of the API",
      "get": {
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/register": {
      "post": {
        "summary": "Register account",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "john@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "password"
                  },
                  "name": {
                    "type": "string",
                    "optional": true,
                    "example": "John Doe"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Authenticated"
          },
          "409": {
            "description": "User already exists with the provided email"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/v1/login": {
      "post": {
        "summary": "Login to account",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "john@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "password"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Authenticated"
          },
          "409": {
            "description": "User already exists with the provided email"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "summary": "Get account",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "User",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "User identifier"
                    },
                    "email": {
                      "type": "string",
                      "description": "User email"
                    },
                    "name": {
                      "type": "string",
                      "description": "User name"
                    },
                    "created": {
                      "type": "string",
                      "description": "User creation date"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "patch": {
        "summary": "Update account",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "optional": true,
                    "example": "John Doe"
                  },
                  "email": {
                    "type": "string",
                    "optional": true,
                    "example": "john@example.com"
                  },
                  "password": {
                    "type": "string",
                    "optional": true,
                    "example": "password"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "User",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "User identifier"
                    },
                    "email": {
                      "type": "string",
                      "description": "User email"
                    },
                    "name": {
                      "type": "string",
                      "description": "User name"
                    },
                    "created": {
                      "type": "string",
                      "description": "User creation date"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "409": {
            "description": "User already exists with the provided email"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/v1/tenant": {
      "post": {
        "summary": "Create tenant",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Tenant name",
                    "example": "Acme School Inc"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "description": "Created tenant identifier"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Get all tenants",
        "description": "Get all tenants for the authenticated user",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tenant/{tenantId}/apns": {
      "get": {
        "summary": "Get APNS CSR",
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "g0kLTz0--BP6"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/x-plist": {
                "schema": {
                  "description": "The `Certificate Signing Request.plist` file. You should upload this file to the [Apple Push Cert Portal](https://identity.apple.com/pushcert) to create an APNS certificate and upload the PEM returned by Apple to Mattrax using `POST /api/v1/tenant/{tenantId}/apns`."
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Update APNS certificate",
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "g0kLTz0--BP6"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successfully updated the APNS certificate"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Enrollment": {
        "type": "object",
        "description": "bruh",
        "properties": {}
      }
    }
  }
}
