{
  "name": "@mattrax/web",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "wrangler types --cwd src && vite build",
    "start": "vite start",
    "preview": "vite preview",
    "typecheck": "tsc",
    "deploy:prod": "pnpm build && pnpm --dir ../.. doc:build && rm -rf dist/client/docs && mkdir -p dist/client/docs && cp -R ../../docs/.vitepress/dist/. dist/client/docs/ && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@kobalte/core": "^0.13.11",
    "@paralleldrive/cuid2": "^3.3.0",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.16.1",
    "@solidjs/start": "https://pkg.pr.new/solidjs/solid-start/@solidjs/start@2080",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/solid-query": "catalog:",
    "better-auth": "^1.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-solid": "^1.8.0",
    "solid-js": "^1.9.12",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.31.2",
    "@types/node": "^25.6.0",
    "shadcn": "^4.2.0",
    "vite": "^7.1.10",
    "wrangler": "^4.81.1"
  },
  "engines": {
    "node": ">=22"
  }
}
