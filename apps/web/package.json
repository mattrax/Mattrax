{
  "name": "@mattrax/web",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/generate-licences.mjs && vp dev",
    "build": "node ../../scripts/generate-licences.mjs && vp build",
    "preview": "vp preview",
    "typecheck": "cf workers types && tsc",
    "deploy": "cf deploy --prebuilt",
    "deploy:prod": "pnpm --dir ../.. doc:build && pnpm build && node ../../scripts/copy-docs.mjs && node ../../scripts/bundle-budget.mjs web && cf deploy --prebuilt",
    "cf:types": "cf workers types"
  },
  "dependencies": {
    "@fontsource-variable/geist": "catalog:",
    "@kobalte/core": "catalog:",
    "@mattrax/enterprise-domain": "workspace:*",
    "@paralleldrive/cuid2": "catalog:",
    "@simplewebauthn/browser": "catalog:",
    "@solidjs/meta": "catalog:",
    "@solidjs/router": "catalog:",
    "@solidjs/web": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/solid-query": "catalog:",
    "@yielded/auth": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "effect": "catalog:",
    "posthog-js": "catalog:",
    "solid-js": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "uqr": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@rolldown/perf-kit": "catalog:",
    "@solidjs/vite-plugin": "catalog:",
    "@types/node": "catalog:",
    "cf": "catalog:",
    "filesystem-routing": "catalog:",
    "shadcn": "catalog:",
    "vite": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
