{"id":"windows/settings/preferences","platform":"windows","kind":"csp","surface":"settings","identifier":"preferences","name":"Preferences","description":"Windows MDM settings in the Preferences category, applied as OMA-URI (SyncML) values.","group":"Microsoft Edge Update","properties":[{"key":"Pol_AutoUpdateCheckPeriod","name":"Auto-update check period override","type":"enum","description":"If enabled, this policy lets you set a value for the minimum number of minutes between automatic update checks. Otherwise, by default, auto-update checks for updates every 10 hours.\n\n If you want to disable all auto-update checks, set the value to 0 (not recommended).","defaultValue":0,"enum":[{"value":"0","description":"Disabled"},{"value":"1","description":"Enabled"}],"address":"./Device/Vendor/MSFT/Policy/Config/update~Policy~Cat_Google~Cat_GoogleUpdate~Cat_Preferences/Pol_AutoUpdateCheckPeriod","scope":"device","introducedIn":"CSP 5.0","source":"https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-update"},{"key":"Part_UpdateCheckSuppressedDurationMin","name":"Duration (Device)","type":"integer","description":"","defaultValue":60,"address":"./Device/Vendor/MSFT/Policy/Config/update~Policy~Cat_Google~Cat_GoogleUpdate~Cat_Preferences/Pol_UpdateCheckSuppressedPeriod","scope":"device","introducedIn":"CSP 5.0","min":1,"max":960,"source":"https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-update"},{"key":"Part_UpdateCheckSuppressedStartHour","name":"Hour (Device)","type":"integer","description":"","defaultValue":0,"address":"./Device/Vendor/MSFT/Policy/Config/update~Policy~Cat_Google~Cat_GoogleUpdate~Cat_Preferences/Pol_UpdateCheckSuppressedPeriod","scope":"device","introducedIn":"CSP 5.0","min":0,"max":23,"source":"https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-update"},{"key":"Part_UpdateCheckSuppressedStartMin","name":"Minute (Device)","type":"integer","description":"","defaultValue":0,"address":"./Devi