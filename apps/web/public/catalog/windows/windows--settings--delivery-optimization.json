{"id":"windows/settings/delivery-optimization","platform":"windows","kind":"csp","surface":"settings","identifier":"delivery-optimization","name":"Delivery Optimization","description":"Windows MDM settings in the Delivery Optimization category, applied as OMA-URI (SyncML) values.","properties":[{"key":"DOAbsoluteMaxCacheSize","name":"DO Absolute Max Cache Size","type":"integer","description":"Specifies the maximum size in GB of Delivery Optimization cache. This policy overrides the MaxCacheSize policy.","defaultValue":0,"address":"./Device/Vendor/MSFT/Policy/Config/DeliveryOptimization/DOAbsoluteMaxCacheSize","scope":"device","minOs":"10.0.14393+","introducedIn":"CSP 4.1","min":0,"max":4294967295,"source":"https://docs.microsoft.com/windows/client-management/mdm/policy-csp-DeliveryOptimization#doabsolutemaxcachesize"},{"key":"DOAllowVPNPeerCaching","name":"DO Allow VPN Peer Caching","type":"enum","description":"Specifies whether the device, with an active VPN connection, is allowed to participate in P2P or not.","defaultValue":0,"enum":[{"value":"0","description":"Not allowed"},{"value":"1","description":"Allowed"}],"address":"./Device/Vendor/MSFT/Policy/Config/DeliveryOptimization/DOAllowVPNPeerCaching","scope":"device","minOs":"10.0.15063+","introducedIn":"CSP 5.0","source":"https://docs.microsoft.com/windows/client-management/mdm/policy-csp-DeliveryOptimization#doallowvpnpeercaching"},{"key":"DOCacheHost","name":"DO Cache Host","type":"array","description":"Specifies one or more Microsoft Connected Cache servers that will be used by your client(s). One or more values can be added as either fully qualified domain names (FQDN) or IP addresses. To add multiple values, separate each FQDN or IP address by commas.","defaultValue":null,"address":"./Device/Vendor/MSFT/Policy/Config/DeliveryOptimization/DOCacheHost","scope":"device","minOs":"10.0.16299+","introducedIn":"CSP 6.0","source":"https://docs.microsoft.com/windows/client-management/mdm/policy-csp-DeliveryOptimization#docachehost"},{"key":"DOCacheHostSource","name":"DO Cache Host Source","type":"integer","description":"Specifies how your client(s) can discover Microsoft Connected Cache servers dynamically.","defaultValue":0,"address":"./Device/Vendor/MSFT/Policy/Config/DeliveryOptimization/DOCacheHostSource","scope":"device","minOs":"10.0.19041+","introducedIn":"CSP 10.0","min":1,"max":2,"source":"https://docs.microsoft.com/windows/client-management/mdm/policy-csp-DeliveryOptimization#docachehostsource"},{"key":"DODelayBackgroundDownloadFromHttp","name":"DO Delay Background Download From Http","type":"integer","description":"For background downloads that use P2P, specifies the time to wait before starting to download from the HTTP source.","defaultValue":0,"address":"./Device/Vendor/MSFT/Policy/Config/DeliveryOptimization/DODelayBackgroundDownloadFromHttp","scope":"device","minOs":"10.0.17134+","introducedIn":"CSP 7.0","min":0,"max":4294967295,"source":"https://docs.microsoft.com/windows/client-management/mdm/policy-csp-DeliveryOptimization#dodelaybackgrounddownloadfromhttp"},{"key":"DODelayCacheServerFallbackBackground","name":"DO Delay Cache Server Fallback Background","type":"integer","description":"For background downloads that use a cache server, specifies the time to wait before falling back to download from the original HTTP source.","defaultValue":0,"address":"./Device/Vendor/MSFT/Policy/Config/DeliveryOptimization/DODelayCacheServerFallbackBackground","scope":"device","minOs":"10.0.18362+","introducedIn":"CSP 9.0","min":0,"max":2592000,"source":"https://docs.microsoft.com/windows/client-management/mdm/policy-csp-DeliveryOptimization#dodelaycacheserverfallbackbackground"},{"key":"DODelayCacheServerFallbackForeground","name":"DO Delay Cache Server Fallback Foreground","type":"integer","description":"For foreground downloads that use a cache server, specifies the time to wait before falling back to download from the original HTTP source.","defaultValue":0,"address":"./Device/Vendor/MSFT/Policy/Config/DeliveryOptimization/DODelayCacheServerFallbackForeground","scope":"device","minOs":"10.0.18362+","introducedIn":"CSP 9.0","min":0,"max":2592000,"source":"https://docs.microsoft.com/windows/client-management/mdm/policy-csp-DeliveryOptimization#dodelaycacheserverfallbackforeground"},{"key":"DODelayForegroundDownloadFromHttp","name":"DO Delay Foreground Download From Http","type":"integer","description":"For foreground downloads that use P2P, specifies the time to wait before starting to download from the HTTP source.","defaultValue":0,"address":"./Device/Vendor/MSFT/Policy/Config/DeliveryOptimization/DODelayForegroundDownloadFromHttp","scope":"device","minOs":"10.0.17134+","introducedIn":"CSP 7.0","min":0,"max":4294967295,"source":"https://docs.microsoft.com/windows/client-management/mdm/policy-csp-DeliveryOptimization#dodelayforegrounddownloadfromhttp"},{"key":"DODisallowCacheServerDownloadsOnVPN","name":"DO Disallow Cache Server Downloads On VPN","type":"enum","description":"Specify to disallow downloads from Microsoft Connected Cache servers when the device has an active VPN connection. By default, the button is 'Not Set'. This means the device is allowed to download from Microsoft Connected Cache when the device has an active VPN connection. To block these downloads, turn the button on to 'Enabled'.","defaultValue":0,"enum":[{"value":"0","description":"Not Set"},{"value":"1","description":"Enabled"}],"address":"./Device/Vendor/MSFT/Policy/Config/DeliveryOptimization/DODisallowCacheServerDownloadsOnVPN","scope":"device","minOs":"10.0.22621.2361+","introducedIn":"CSP 11.0","source":"https://docs.microsoft.com/windows/client-management/mdm/policy-csp-DeliveryOptimization#dodisallowcacheserverdownloadsonvpn"},{"key":"DODownloadMode","name":"DO Download Mode","type":"enum","description":"Specifies the method that Delivery Optimization can use to download content on behalf of various Microsoft products.","defaultValue":0,"enum":[{"value":"0","description":"HTTP only, no peering"},{"value":"1","description":"HTTP blended with peering behind the same NAT"},{"value":"2","description":"HTTP blended with peering across a private group"},{"value":"3","description":"HTTP blended with Internet peering"},{"value":"99","description":"HTTP only, no peering, no use of DO cloud service"},{"value":"100","description":"Bypass mode, deprecated in Windows 11"}],"address":"./Device/Vendor/MSFT/Policy/Config/DeliveryOptimization/DODownloadMode","scope":"device","minOs":"10.0.10240+","introducedIn":"CSP 1.0","source":"https://docs.microsoft.com/windows/client-management/mdm/policy-csp-DeliveryOptimization#dodownloadmode"},{"key":"DOGroupId","name":"DO Group Id","type":"string","description":"Specifies an arbitrary group ID that the device belongs to. A GUID must be used.","defaultValue":null,"address":"./Device/Vendor/MSFT/Policy/Config/DeliveryOptimization/DOGroupId","scope":"device","minOs":"10.0.14393+","introducedIn":"CSP 4.1","source":"https://docs.microsoft.com/windows/client-management/mdm/policy-csp-DeliveryOptimization#dogroupid"},{"key":"DOGroupIdSource","name":"DO Group Id Source","type":"enum","description":"Specifies the source of group ID used for peer selection.","defaultValue":0,"enum":[{"value":"0","description":"Not Set"},{"value":"1","description":"AD site"},{"value":"2","description":"Authenticated domain SID"},{"value":"3","description":"DHCP Option ID"},{"value":"4","description":"DNS Suffix"},{"value":"5","description":"Entra ID Tenant ID"}],"address":"./Device/Vendor/MSFT/Policy/Config/DeliveryOptimization/DOGroupIdSource","scope":"device","minOs":"10.0.17134+","introducedIn":"CSP 7.0","source":"https://docs.microsoft.com/windows/client-management/mdm/policy-csp-DeliveryOptimization#dogroupidsource"},{"key":"DOMaxBackgroundDownloadBandwidth","name":"DO Max Background Download Bandwidth","type":"integer","description":"Specifies the maximum background download bandwidth in KiloBytes/second that the device can use across all concurrent download activities using Delivery Optimization.","defaultValue":0,"address":"./Device/Vendor/MSFT/Policy/Config/DeliveryOptimization/DOMaxBackgroundDownloadBandwidth","scope":"device","minOs":"10.0.19041+","introducedIn":"CSP 10.0","min":0,"max":4294967295,"source":"https://docs.microsoft.com/windows/client-management/mdm/policy-csp-DeliveryOptimization#domaxbackgrounddownloadbandwidth"},{"key":"DOMaxCacheAge","name":"DO Max Cache Age","type":"integer","description":"Specifies the maximum time in seconds that each file is held in the Delivery Optimization cache after downloading successfully.","defaultValue":0,"address":"./Device/Vendor/MSFT/Policy/Config/DeliveryOptimization/DOMaxCacheAge","scope":"device","minOs":"10.0.10240+","introducedIn":"CSP 1.0","min":0,"max":4294967295,"source":"https://docs.microsoft.com/windows/client-management/mdm/policy-csp-DeliveryOptimization#domaxcacheage"},{"key":"DOMaxCacheSize","name":"DO Max Cache Size","type":"integer","description":"Specifies the maximum cache size that Delivery Optimization can utilize, as a percentage of the available drive space.","defaultValue":0,"address":"./Device/Vendor/MSFT/Policy/Config/DeliveryOptimization/DOMaxCacheSize","scope":"device","minOs":"10.0.10240+","introducedIn":"CSP 1.0","min":1,"max":100,"source":"https://docs.microsoft.com/windows/client-management/mdm/policy-csp-DeliveryOptimization#domaxcachesize"},{"key":"DOMaxDownloadBandwidth","name":"DO Max Download Bandwidth","type":"integer","description":"This policy specifies the maximum foreground download bandwidth in KiloBytes/second that the device can use across all concurrent download activities using Delivery Optimization.\\r\\nThe default value 0 (zero) means that Delivery Optimization dynamically adjusts to use the available bandwidth for downloads.","defaultValue":0,"address":"./Device/Vendor/MSFT/Policy/Config/DeliveryOptimization/DOMaxDownloadBandwidth","scope":"device","introducedIn":"C