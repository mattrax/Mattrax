ge Allowed To Upload","type":"integer","description":"Specifies the minimum battery level required for uploading to peers, while on battery power.","defaultValue":0,"address":"./Device/Vendor/MSFT/Policy/Config/DeliveryOptimization/DOMinBatteryPercentageAllowedToUpload","scope":"device","minOs":"10.0.15063+","introducedIn":"CSP 5.0","min":0,"max":100,"source":"https://docs.microsoft.com/windows/client-management/mdm/policy-csp-DeliveryOptimization#dominbatterypercentageallowedtoupload"},{"key":"DOMinDiskSizeAllowedToPeer","name":"DO Min Disk Size Allowed To Peer","type":"integer","description":"Specifies the required minimum total disk size in GB for the device to use P2P.","defaultValue":0,"address":"./Device/Vendor/MSFT/Policy/Config/DeliveryOptimization/DOMinDiskSizeAllowedToPeer","scope":"device","minOs":"10.0.15063+","introducedIn":"CSP 5.0","min":1,"max":100000,"source":"https://docs.microsoft.com/windows/client-management/mdm/policy-csp-DeliveryOptimization#domindisksizeallowedtopeer"},{"key":"DOMinFileSizeToCache","name":"DO Min File Size To Cache","type":"integer","description":"Specifies the minimum content file size in MB eligible to use P2P.","defaultValue":0,"address":"./Device/Vendor/MSFT/Policy/Config/DeliveryOptimization/DOMinFileSizeToCache","scope":"device","minOs":"10.0.15063+","introducedIn":"CSP 5.0","min":1,"max":100000,"source":"https://docs.microsoft.com/windows/client-management/mdm/policy-csp-DeliveryOptimization#dominfilesizetocache"},{"key":"DOMinRAMAllowedToPeer","name":"DO Min RAM Allowed To Peer","type":"integer","description":"Specifies the minimum total RAM size in GB required to use P2P.","defaultValue":0,"address":"./Device/Vendor/MSFT/Policy/Config/DeliveryOptimization/DOMinRAMAllowedToPeer","scope":"device","minOs":"10.0.15063+","introducedIn":"CSP 5.0","min":1,"max":100000,"source":"https://docs.microsoft.com/windows/client-management/mdm/policy-csp-DeliveryOptimization#dominramallowedtopeer"},{"key":"DOModifyCacheDrive","name":