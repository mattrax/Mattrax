{"id":"windows/settings/files","platform":"windows","kind":"csp","surface":"settings","identifier":"files","name":"Files","description":"Windows MDM settings in the Files category, applied as OMA-URI (SyncML) values.","group":"Microsoft Office 2016","properties":[{"key":"L_CheckifOfficeisthedefaulteditorforWebpagescreatedinOffice","name":"Check if Office is the default editor for Web pages created in Office (User)","type":"enum","description":"Checks/Unchecks the corresponding UI option.","defaultValue":0,"enum":[{"value":"0","description":"Disabled"},{"value":"1","description":"Enabled"}],"address":"./User/Vendor/MSFT/Policy/Config/office16v2~Policy~L_MicrosoftOfficeSystem~L_ToolsOptionsGeneralWebOptions~L_Files/L_CheckifOfficeisthedefaulteditorforWebpagescreatedinOffice","scope":"user","introducedIn":"CSP 5.0","source":"https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-office16v2"},{"key":"L_CheckifWordisthedefaulteditorforallotherWebpages","name":"Check if Word is the default editor for all other Web pages (User)","type":"enum","description":"Checks/unchecks the corresponding UI option.","defaultValue":0,"enum":[{"value":"0","description":"Disabled"},{"value":"1","description":"Enabled"}],"address":"./User/Vendor/MSFT/Policy/Config/word16v2~Policy~L_MicrosoftOfficeWord~L_WordOptions~L_Advanced~L_WebOptions~L_Files/L_CheckifWordisthedefaulteditorforallotherWebpages","scope":"user","introducedIn":"CSP 5.0","source":"https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-word16v2"},{"key":"L_OpenOfficeDocumentDirectlyInOfficeApplication","name":"Open Office document directly in Office application (User)","type":"enum","description":"This policy setting allows you to choose whether Office documents located on web servers open directly in the registered application or through the web browser. \n\nIf you enable this policy setting, files will open directly in the associated Office application, bypassing the web browser.\n\nI