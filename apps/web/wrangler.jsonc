{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mattrax",
  "main": "@solidjs/start/server/entry",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "route": {
    "pattern": "mattrax.cloud",
    "custom_domain": true,
  },
  "observability": {
    "enabled": true,
  },
  "services": [
    {
      "binding": "API",
      "service": "mattrax-api",
    },
  ],
}
