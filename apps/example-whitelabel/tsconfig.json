{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "composite": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js"
  },
  "references": [
    {
      "path": "../../packages/management-backend"
    },
    {
      "path": "../../packages/management-backend-http"
    },
    {
      "path": "../../packages/dm-apple"
    },
    {
      "path": "../../packages/scep"
    },
    {
      "path": "../../packages/apns"
    }
  ],
  "include": ["src", "package.json", "cloudflare.config.ts", ".cloudflare/types"],
  "exclude": ["vite.config.ts", "node_modules"]
}
