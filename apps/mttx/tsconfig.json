{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "dom"],
    "types": ["node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "composite": true
  },
  "references": [
    { "path": "../../packages/enterprise-domain" },
    { "path": "../../packages/enterprise-backend" },
    { "path": "../../packages/dm-apple" },
    { "path": "../../packages/dm-windows" },
    { "path": "../../packages/management-backend" },
    { "path": "../../packages/management-backend-http" },
    { "path": "../../packages/scep" },
    { "path": "../../packages/crypto" }
  ],
  "include": ["src", "package.json"],
  "exclude": ["node_modules"]
}
