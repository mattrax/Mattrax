{
  "name": "@mattrax/cloud",
  "version": "0.0.0",
  "private": true,
  "description": "Mattrax Cloud entry point: Cloudflare API Worker, MDM, billing and deployment migrations.",
  "type": "module",
  "exports": {
    "./runtime": {
      "types": "./dist/app.d.ts",
      "import": "./src/app.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "perf:report": "MATTRAX_PERF_REPORT=1 vp build",
    "preview": "vp preview",
    "deploy": "cf deploy --prebuilt --force",
    "deploy:prod": "pnpm build && tsx ../../packages/config/scripts/bundle-budget.ts cloud && cf deploy --prebuilt --force",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "cf:types": "cf workers types",
    "typecheck": "cf workers types && tsc",
    "license:issue": "tsx scripts/issue-license.ts"
  },
  "dependencies": {
    "@effect/sql-mysql2": "catalog:",
    "@mattrax/apns": "workspace:*",
    "@mattrax/azure-graph": "workspace:*",
    "@mattrax/azure-oidc": "workspace:*",
    "@mattrax/cloud-services": "workspace:*",
    "@mattrax/dm-apple": "workspace:*",
    "@mattrax/dm-windows": "workspace:*",
    "@mattrax/effect-stripe": "workspace:*",
    "@mattrax/enterprise-api": "workspace:*",
    "@mattrax/enterprise-backend": "workspace:*",
    "@mattrax/enterprise-core": "workspace:*",
    "@mattrax/enterprise-domain": "workspace:*",
    "@mattrax/google-workspace": "workspace:*",
    "@mattrax/management-backend-http": "workspace:*",
    "@mattrax/mdm-apple": "workspace:*",
    "@mattrax/scep": "workspace:*",
    "@yielded/auth": "catalog:",
    "@yielded/auth-platform-workerd": "catalog:",
    "effect": "catalog:",
    "mysql2": "catalog:",
    "reflect-metadata": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@rolldown/perf-kit": "catalog:",
    "@types/node": "catalog:",
    "cf": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
