{
  "name": "@mattrax/services",
  "version": "0.0.0",
  "private": true,
  "description": "Hosted Mattrax services: APNs relay, deployment licences and hosted tenant billing.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate-cli.ts",
    "entitlements:reconcile": "tsx scripts/reconcile-entitlements.ts",
    "typecheck": "tsc --noEmit",
    "db:import-legacy": "tsx scripts/import-legacy.ts"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-mysql2": "catalog:",
    "@mattrax/apns": "workspace:*",
    "@mattrax/cloud-services": "workspace:*",
    "@mattrax/effect-stripe": "workspace:*",
    "@mattrax/enterprise-billing": "workspace:*",
    "@mattrax/enterprise-core": "workspace:*",
    "effect": "catalog:",
    "mysql2": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
