{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mattrax-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "mattrax.cloud/api/*",
      "zone_name": "mattrax.cloud",
    },
    {
      "pattern": "mattrax.cloud/mdm/*",
      "zone_name": "mattrax.cloud",
    },
  ],
  "observability": {
    "enabled": true,
  },
  "placement": {
    "mode": "smart",
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "3045b1ca406549288f7b65e97308b959",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/mattraxe",
    },
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "mattrax",
    },
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["hello@mattrax.cloud"],
    },
  ],
  "vars": {
    "ORIGIN": "https://mattrax.cloud",
  },
  "secrets": {
    "required": [
      "AUTH_SECRET",
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET",
      "STRIPE_DEVICE_MONTHLY_PRICE_ID",
      "CLOUD_APPLE_VENDOR_CERT",
      "CLOUD_APPLE_VENDOR_KEY",
    ],
  },
}
