{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mattrax-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "ORIGIN": "https://mattrax.cloud",
    "BETTER_AUTH_URL": "https://mattrax.cloud",
  },
  "placement": {
    "mode": "smart",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mattrax",
      "database_id": "310ef1ff-67fd-4952-861a-e4cab413ca78",
    },
  ],
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
}
