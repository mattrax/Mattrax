{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mattrax-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "mattrax.cloud/api/*",
      "zone_name": "mattrax.cloud",
    },
    {
      "pattern": "mattrax.cloud/mdm/*",
      "zone_name": "mattrax.cloud",
    },
  ],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "ORIGIN": "https://mattrax.cloud",
  },
  "secrets": {
    "required": ["AUTH_SECRET", "CLOUD_APPLE_VENDOR_CERT", "CLOUD_APPLE_VENDOR_KEY"],
  },
  "placement": {
    "mode": "smart",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mattrax",
      "database_id": "310ef1ff-67fd-4952-861a-e4cab413ca78",
    },
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["hello@mattrax.cloud"],
    },
  ],
}
