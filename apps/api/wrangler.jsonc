{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mattrax-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "route": {
    "pattern": "mattraxe.otbeaumont.me",
    "custom_domain": true,
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    "ORIGIN": "https://mattraxe.otbeaumont.me"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mattrax",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
}
