{
  "name": "@mattrax/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "wrangler types --cwd src && vp build",
    "preview": "vp preview",
    "deploy:prod": "pnpm build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "migrate:prod": "wrangler d1 migrations apply mattrax --remote",
    "migrate:local": "wrangler d1 migrations apply mattrax --local"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.2",
    "@mattrax/dm-apple": "workspace:*",
    "@mattrax/enterprise-backend": "workspace:*",
    "@mattrax/enterprise-domain": "workspace:*",
    "@mattrax/management-backend": "workspace:*",
    "@mattrax/management-backend-http": "workspace:*",
    "@mattrax/platform-api": "workspace:*",
    "@mattrax/platform-backend": "workspace:*",
    "@mattrax/scep": "workspace:*",
    "asn1js": "catalog:",
    "better-auth": "^1.6.2",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "fast-plist": "catalog:",
    "pkijs": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@types/node": "catalog:",
    "@types/pkijs": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.0.0"
  }
}
